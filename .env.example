# Generate random local database credentials with python scripts/setup_local.py.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://campusfind:replace-with-a-long-random-database-password@127.0.0.1:5433/campusfind
CAMPUSFIND_ORIGIN=http://127.0.0.1:8000
CAMPUSFIND_SECURE_COOKIE=false
# Exact domains, comma-separated. This is NOT email verification.
CAMPUSFIND_EMAIL_DOMAINS=
CAMPUSFIND_RETENTION_DAYS=180
CAMPUSFIND_TIMEZONE=Asia/Kolkata
# Optional absolute private directory, never exposed through a web server:
# CAMPUSFIND_STORAGE=C:/CampusFind/private-images
# Phase 5: development permits local signup; production requires operator-issued accounts.
CAMPUSFIND_ENV=development
# Production always uses the separate durable worker instead of HTTP background tasks.
CAMPUSFIND_BACKGROUND_MATCHING=true
# Optional PostgreSQL client-tool directory for backup/recovery (not a secret).
# CAMPUSFIND_PG_BIN=C:/Program Files/PostgreSQL/17/bin
